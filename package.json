{
  "name": "linkshelf-menubar-macos",
  "version": "1.0.0",
  "description": "macOS menu bar app for storing and copying links and text snippets",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run start:react\" \"wait-on http://localhost:3000 && npm run start:electron\"",
    "start:react": "vite",
    "start:electron": "env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://localhost:3000 npx electron electron/main.js",
    "dev": "npm run start",
    "electron": "env -u ELECTRON_RUN_AS_NODE npx electron electron/main.js",
    "build": "vite build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "package": "npm run build && npm run build:electron && electron-builder",
    "lint": "eslint src electron",
    "lint:fix": "eslint src electron --fix",
    "icons": "env -u ELECTRON_RUN_AS_NODE npx electron scripts/build-icons.js"
  },
  "build": {
    "appId": "com.linkshelf.menubar",
    "productName": "Linkshelf",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "electron/assets/icon.icns"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "electron/assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron-dist/main.js"
    }
  },
  "keywords": [
    "electron",
    "menubar",
    "clipboard",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-reloader": "2.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.5",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wait-on": "9.5.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "allo-font": "1.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-store": "12.0.0",
    "lucide-react": "1.77.0",
    "menubar": "9.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  }
}
